{
  "name": "basalto",
  "productName": "Basalto",
  "version": "0.1.0",
  "description": "Editor de notas Markdown local, baseado em cofres (pastas), inspirado na arquitetura do Obsidian e reimplementado do zero.",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs && electron . --dev",
    "web": "node build.mjs && node server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@replit/codemirror-vim": "^6.4.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.3",
    "katex": "^0.19.0",
    "lucide": "^1.57.0",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0"
  }
}
